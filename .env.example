# Copy to .env for local development: cp .env.example .env
# Real environment variables override anything in this file.

PORT=8080

# MongoDB (docker/docker-compose.yml starts one with these credentials)
DB_URI=mongodb://echo:echo@localhost:27017

# Redis: host:port, or a full redis:// / rediss:// URL (e.g. Upstash, Render Key Value)
REDIS_URI=localhost:6379
REDIS_PASS=

# Secret used to sign JWTs. Use a long random value outside local dev.
JWT_SECRET=echo-dev-secret

# Leave LOG_FILE empty to log to stdout (recommended on hosting platforms)
LOG_FILE=logs/server.log
LOG_LEVEL=debug
